\\"npmRebuild\\\": false,\\n   141\\t    \\\"afterPack\\\": \\\"scripts/after-pack.js\\\",\\n   142\\t    \\\"afterSign\\\": \\\"scripts/after-sign.js\\\",\\n   143\\t    \\\"asarUnpack\\\": [\\n   144\\t      \\\"node_modules/node-pty/**\\\",\\n   145\\t      \\\"node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**\\\"\\n   146\\t    ],\\n   147\\t    \\\"directories\\\": {\\n   148\\t      \\\"output\\\": \\\"release\\\",\\n   149\\t      \\\"buildResources\\\": \\\"build\\\"\\n   150\\t    },\\n   151\\t    \\\"files\\\": [\\n   152\\t      \\\"dist/**\\\",\\n   153\\t      \\\"dist-electron/**\\\",\\n   154\\t      \\\"package.json\\\"\\n   155\\t    ],\\n   156\\t    \\\"mac\\\": {\\n   157\\t      \\\"category\\\": \\\"public.app-category.developer-tools\\\",\\n   158\\t      \\\"target\\\": [\\n   159\\t        {\\n   160\\t          \\\"target\\\": \\\"dmg\\\",\\n   161\\t          \\\"arch\\\": [\\n   162\\t            \\\"x64\\\",\\n   163\\t            \\\"arm64\\\"\\n   164\\t          ]\\n   165\\t        }\\n   166\\t      ],\\n   167\\t      \\\"icon\\\": \\\"build/icon.icns\\\",\\n   168\\t      \\\"hardenedRuntime\\\": false,\\n   169\\t      \\\"gatekeeperAssess\\\": false,\\n   170\\t      \\\"identity\\\": null,\\n   171\\t      \\\"extendInfo\\\": {\\n   172\\t        \\\"NSCameraUsageDescription\\\": \\\"Sage 内置浏览器需要摄像头以支持网页身份验证和视频通话。\\\",\\n   173\\t        \\\"NSMicrophoneUsageDescription\\\": \\\"Sage 需要麦克风以提供语音输入（听写）功能。\\\",\\n   174\\t        \\\"NSSpeechRecognitionUsageDescription\\\": \\\"Sage 使用 macOS 系统语音识别将你的语音转为文字。\\\"\\n   175\\t      }\\n   176\\t    },\\n   177\\t    \\\"dmg\\\": {\\n   178\\t      \\\"title\\\": \\\"Sage ${version}\\\"\\n   179\\t    },\\n   180\\t    \\\"extraResources\\\": [\\n   181\\t      {\\n   182\\t        \\\"from\\\": \\\"resources/skills\\\",\\n   183\\t        \\\"to\\\": \\\"skills\\\",\\n   184\\t        \\\"filter\\\": [\\n   185\\t          \\\"**/SKILL.md\\\"\\n   186\\t        ]\\n   187\\t  