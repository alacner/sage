          "input": {
            "file_path": "/Users/alacner/sandbox/sage-github/package.json"
          },
          "contentOffset": 87,
          "approval": "allowed",
          "result": "     1\t{\n     2\t  \"name\": \"sage\",\n     3\t  \"version\": \"0.6.860\",\n     4\t  \"description\": \"A macOS AI workspace for conversations and extensible project workflows\",\n     5\t  \"main\": \"dist-electron/electron/main.js\",\n     6\t  \"author\": \"Sage\",\n     7\t  \"license\": \"MIT\",\n     8\t  \"private\": true,\n     9\t  \"scripts\": {\n    10\t    \"dev\": \"concurrently -k -n vite,electron -c blue,green \\\"npm:dev:renderer\\\" \\\"npm:dev:electron\\\"\",\n    11\t    \"dev:renderer\": \"vite\",\n    12\t    \"dev:electron\": \"wait-on tcp:5173 && npm run build:native-shortcuts && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .\",\n    13\t    \"build:renderer\": \"vite build\",\n    14\t    \"build:electron\": \"tsc -p electron/tsconfig.json\",\n    15\t    \"build\": \"npm run build:native-shortcuts && npm run check:bundled-plugins && npm run build:workflow-plugins && node scripts/gen-build-info.cjs && npm run build:renderer && npm run build:electron && node scripts/install-recovered-renderer.cjs\",\n    16\t    \"preview\": \"npm run build && electron .\",\n    17\t    \"typecheck\": \"tsc --noEmit && tsc -p electron/tsconfig.json --noEmit\",\n    18\t    \"test:settings\": \"node scripts/test-settings-integrity.cjs && node scripts/test-settings-autosave.cjs && node scripts/test-provider-key-probe.cjs && node scripts/test-settings-relay-apply.cjs && node scripts/test-update-source.cjs\",\n    19\t    \"test:security\": \"node scripts/test-security-settings.cjs && node scripts/test-single-review-ui.cjs && node scripts/test-security-profiles.cjs && node scripts/test-security-profile-ui.cjs && node scripts/test-sandbox-review.cjs && node scripts/test-tool-decisions.cjs && node scripts/test-decision-history-ui.cjs && node scripts/test-cli-security.cjs && node scripts/test-privacy-probe.cjs && node scripts/test-privacy-identity.cjs && node scripts/test-review-policy.cjs && node scripts/test-revi