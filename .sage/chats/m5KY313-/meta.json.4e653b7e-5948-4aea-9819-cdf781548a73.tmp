          "result": "     1\timport { inheritedModelDescriptor } from '../shared/inherited-model';\n     2\timport { listProjects } from './store';\n     3\timport { readMobileModelCatalog } from './mobile-model-catalog';\n     4\t/** Validated mobile operations; no generic desktop IPC or settings access. */\n     5\timport { app, BrowserWindow } from 'electron';\n     6\timport { MobileManagementChangedChannel, type MobileManagementChangedPayload } from '../shared/ipc';\n     7\timport type { MobileActionHandler } from './mobile-bridge';\n     8\timport { readSettings } from './main';\n     9\timport { browseMobileProjectDirectories, createMobileProject, mobileProjectCreationOptions, openMobileProject } from './mobile-project-creation';\n    10\timport { saveConv, addProject } from './store';\n    11\timport { chatCapabilities } from './chat-capabilities';\n    12\timport type { ConversationMeta, ImageAttachment } from '../shared/types';\n    13\timport { defaultSecurityProfile, enabledSecurityProfiles, FULL_ACCESS_ID, securityProfiles, securitySnapshot } from '../shared/security-profiles';\n    14\t\n    15\texport function validateMobileMessage(payload: any): { content: string; images?: ImageAttachment[]; clientMessageId?: string } {\n    16\t  if (!payload || typeof payload.content !== 'string' || payload.content.length > 160000) throw Error('消息内容无效或超过 160000 字符');\n    17\t  const images = payload.images;\n    18\t  if (images !== undefined && (!Array.isArray(images) || images.length > 4)) throw Error('最多选择 4 张图片');\n    19\t  let total = 0;\n    20\t  const safeImages = images?.map((image: any) => {\n    21\t    if (!image || typeof image.name !== 'string' || image.name.length > 200 || !['image/png','image/jpeg','image/webp','image/gif'].includes(image.mimeType) || typeof image.dataBase64 !== 'string' || !/^[A-Za-z0-9+/]*={0,2}$/.test(image.dataBase64) || !image.dataBase64.length) throw Error('图片内容无效');\n    22\t    total += image.dataBase64.length;\n    23\t    return { name: image.name, mimeType: image.mimeType, dataBase64: image.dataBase64 };\n    24\t  });\n    25\t  if (total + payload.content.length * 4 > 900000) throw Error('消息过大，请减少图片或文字');\n    26\t  if (!payload.content.trim() && !safeImages?.length) throw Error('请输入消息或选择图片');\n    27\t  if (payload.clientMessageId !== undefined && (typeof payload.clientMessageId !== 'string' || !/^mobile-[a-zA-Z0-9-]{8,100}$/.test(payload.clientMessageId))) throw Error('消息标识无效');\n    28\t  return { content: payload.content.trim(), images: safeImages, clientMessageId: payload.clientMessageId };\n    29\t}\n    30\texport const mobileConversationId = (payload: any) => {\n    31\t  if (typeof payload?.conversationId !== 'string' || !payload.conversationId || payload.conversationId.length > 200) throw Error('对话标识无效');\n    32\t  return payload.conversationId as string;\n    33\t};\n    34\t/** Refresh desktop project lists after persistence; a closing window cannot undo a successful save. */\n    35\tfunction notifyMobileProjectList(projectPath: string): void {\n    36\t  const event: MobileManagementChangedPayload = { section: 'project-list', projectPath };\n    37\t  try {\n    38\t    for (const window of BrowserWindow.getAllWindows()) {\n    39\t      try {\n    40\t        if (window.isDestroyed() || window.webContents.isDestroyed()) continue;\n    41\t      