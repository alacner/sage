          "approval": "allowed",
          "result": "     1\timport { sampleDesktopStatus } from './desktop-status';\n     2\timport { registerMobileTaskConversationActions } from './mobile-task-conversation';\n     3\timport { registerMobileTaskSettingsActions } from './mobile-task-settings';\n     4\timport { registerMobileReminderActions, mobileScheduledRunSummary } from './mobile-reminders';\n     5\timport { registerMobileMessageActions } from './mobile-message-actions';\n     6\timport { registerMobileProjectIconActions } from './mobile-project-icons';\n     7\timport { normalizeProjectIcon } from '../shared/project-icons';\n     8\timport { conversationScheduleState } from '../shared/conversation-status';\n     9\t/**\n    10\t * Mobile Bridge — 移动端遥控器的指令处理器\n    11\t *\n    12\t * 移动端 App 通过 sage-website 下发 mobile_command 指令，\n    13\t * 本模块负责接收、分发、执行，并把结果回传。\n    14\t *\n    15\t * 设计原则（遥控器 + 显示器模式）：\n    16\t *   - 移动端零执行能力，所有副作用都在这里由客户端本地完成\n    17\t *   - 每个 action 都是\"客户端本地已有能力\"的暴露，不引入新业务逻辑\n    18\t *   - 返回结构化结果，relay 透传给移动端\n    19\t *\n    20\t * Phase 0 命令集：\n    21\t *   - ping / get_status\n    22\t *   - list_projects / list_conversations / list_tasks\n    23\t *\n    24\t * Phase 1 命令集：\n    25\t *   - create_conversation / list_messages / append_message\n    26\t *   - create_task / update_task / delete_task / run_task_now\n    27\t */\n    28\t\n    29\timport * as os from 'os';\n    30\timport { registerMobileMermaidActions } from './mobile-mermaid';\n    31\timport { describeMessageImages, registerMobileMessageImageActions } from './mobile-message-images';\n    32\timport { registerMobileApprovalActions } from './mobile-approvals';\n    33\timport { registerMobileManagementActions } from './mobile-management';\n    34\timport { registerMobileProjectActions } from './mobile-project-management';\n    35\timport { registerMobileChatActions, validateMobileMessage } from './mobile-chat';\n    36\timport { initializeConversationPolicy } from './sandbox/conversation-policy';\n    37\timport { listProjects, listConvsForProject, listScheduledTasks, listScheduledRuns, saveConv } from './store';\n    38\timport { \n    39\t  createScheduledTask, \n    40\t  updateScheduledTask, \n    41\t  deleteScheduledTask, \n    42\t  runScheduledTaskNow \n    43\t} from './scheduler';\n    44\timport { newConversation } from './conv-engine';\n    45\timport { conversationFileChanges } from '../shared/file-changes';\n    46\timport { canResumeExperts } from '../shared/experts-resume';\n    47\t\n    48\texport interface MobileCommandResult {\n    49\t  /** HTTP 风格状态码：200 成功、4xx 客户端错误、5xx 服务端错误 */\n    50\t  status: number;\n    51\t  /** 成功时的数据（移动端只读显示用） */\n    52\t  data?: unknown;\n    53\t  /** 失败时的错误信息 */\n    54\t  error?: string;\n    55\t  /** Host-only callback: invoked after the response has been flushed to its relay socket. */\n    56\t  afterReply?: () => Promise<void>;\n    57\t}\n    58\t\n    59\texport type MobileActionHandler = (payload: any) => Promise<MobileCommandResult> | MobileCommandResult;\n    60\t\n    61\t/** action → handler 注册表，便于后续 Phase 扩展新指令 */\n    62\tconst handlers = new Map<string, MobileActionHandler>();\n    63\tconst taskRuns = new Map<string, { running: boolean; error?: string }>();\n    64\tregisterMobileReminderActions(registerMobileAction);\n    65\tregisterMobileTaskSettingsActions(registerMobileAction);\n    66\tregisterMobileTaskConversationActions(registerMobileAction);\n    67\t\n    68\t/**\n    69\t * 注册一个移动端指令处理器。\n    70\t * 在 main.ts 初始化时调用（避免模块间循环依赖）。\n    71\t */\n    72\texport function registerMobileAction(action: string, handler: MobileActionHandler): void {\n    73\t  handlers.set(action, handler);\n    74\t}\n    75\t\n    76\t/**\n    77\t * 处理来自 relay 的 mobile_command。\n    78\t * 返回结构化结果，由 relay-client 回传到 relay。\n    79\t */\n    80\texport async function handleMobileCommand(action: string, payload: any, transport?: unknown): Promise<MobileCommandResult> {\n    81\t  const handler = handlers.get(action);\n    82\t  if (!handler) {\n    83\t    return { status: 404, error: `unknown mobile action: ${action}` };\n    84\t  }\n    85\t  try {\n    86\t    const result = await handler(payload ?? {});\n    87\t    // Old relays omit this top-level field and old clients never negotiate it.\n    88\t    // Keep the handler payload intact so strict business validation is unchanged.\n    89\t    if (transport && result.status >= 200 && result.status < 300 && !result.error) {\n    90\t      try {\n    91\t        const { acceptsResponseCompression, encodeResponseData } = await import('./mobile-transport');\n    92\t        if (acceptsResponseCompression(transport)) {\n    93\t          const data = await encodeResponseData(action, result.data);\n    94\t          if (data !== result.data) return { ...result, data };\n    95\t        }\n    96\t      } catch { /* Compression cannot change a successful operation into an error. */ }\n    97\t    }\n    98\t    return result;\n    99\t  } catch (err: any) {\n   100\t    console.error(`[mobile-bridge] action \"${action}\" failed:`, err);\n   101\t    return { status: 500, error: err?.message ?? String(err) };\n   102\t  }\n   103\t}\n   104\t\n   105\t// ─── Phase 0 命令集 ─────────────────────────────────────────────────────────\n   106\t\n   107\t/**\n   108\t * ping — 链路验证。\n   109\t */\n   110\tregisterMobileAction('desktop_appearance', async () => {\n   111\t  const [{readSettings},{nativeTheme,app},{findBuiltinTheme,APPEARANCE_COLOR_TOKENS},{resolveLanguage}] = await Promise.all([import('./main'),import('electron'),import('../shared/appearance'),import('../shared/language')]);\n   112\t  const settings=await readSettings(),custom=settings.themes?.find(t=>t.id===settings.theme)??findBuiltinTheme(settings.theme);\n   113\t  const mode:'light'|'dark'=custom?.base??(settings.theme==='light'?'light':settings.theme==='dark'?'dark':nativeTheme.shouldUseDarkColors?'dark':'light');\n   114\t  const colors=Object.fromEntries(APPEARANCE_COLOR_TOKENS.filter(t=>['accent','bg0','bg1','bg2','text','textDim','border','err','ok'].includes(t.key)).map(t=>[t.key,t.defaults[mode]]));\n   115\t  const overrides=custom?{...custom.colors,...settings.builtinThemeOverrides?.[custom.id]}:settings.appearance?.colors?.[mode];\n   116\t  for(const key of Object.keys(colors)){const value=overrides?.[key as keyof typeof overrides];if(typeof value==='string'&&/^(#[0-9a-f]{3,8}|rgba?\\([\\d\\s.,%]+\\))$/i.test(value))colors[key]=value;}\n   117\t  return {status:200,data:{mode,colors,language:resolveLanguage(settings.language,app.getLocale()),languageAuthoritative:settings._revision!=='initial'||settings.language!==undefined}};\n   118\t});\n   119\t\n   120\tregisterMobileAction('ping', () => ({\n   121\t  status: 200,\n   122\t  data: {\n   123\t    pong: true,\n   124\t    serverTime: Date.now(),\n   125\t    clientName: os.hostname(),\n   126\t    platform: process.platform,\n   127\t    arch: process.arch,\n   128\t    nodeVersion: process.version,\n   129\t  },\n   130\t}));\n   131\t\n   132\t/**\n   133\t * get_status — 返回客户端运行状态。\n   134\t */\n   135\tregisterMobileAction('get_status', async () => {\n   136\t  const result: Record<string,unknown> = await sampleDesktopStatus();\n   137\t\n   138\t  for (const provider of statusProviders) {\n   139\t    try {\n   140\t      Object.assign(result, provider());\n   141\t    } catch (err) {\n   142\t      console.error('[mobile-bridge] status provider failed:', err);\n   143\t    }\n   144\t  }\n   145\t\n   146\t  return { status: 200, data: result };\n   147\t});\n   148\t\n   149\t/**\n   150\t * list_projects — 列出所有项目。\n   151\t */\n   152\tregisterMobileAction('list_projects', async () => {\n   153\t  const projects = await listProjects();\n   154\t  return {\n   155\t    status: 200,\n   156\t    data: {\n   157\t      projects: projects.map((p) => ({\n   158\t        path: p.path,\n   159\t        name: p.name,\n   160\t        icon: normalizeProjectIcon(p.icon),\n   161\t        lastOpenedAt: p.lastOpenedAt,\n   162\t      })),\n   163\t      total: projects.length,\n   164\t    },\n   165\t  };\n   166\t});\n   167\t\n   168\t/**\n   169\t * list_conversations — 列出指定项目的对话。\n   170\t */\n   171\tregisterMobileAction('list_conversations', async (payload) => {\n   172\t  const { projectPath } = payload;\n   173\t  if (!projectPath || typeof projectPath !== 'string') {\n   174\t    return { status: 400, error: 'missing projectPath' };\n   175\t  }\n   176\t  const [convs, tasks, runs] = await Promise.all([listConvsForProject(projectPath), listScheduledTasks(projectPath), listScheduledRuns(projectPath)]);\n   177\t  const { convIsExecuting } = await import('./ipc');\n   178\t  return {\n   179\t    status: 200,\n   180\t    data: {\n   181\t      projectPath,\n   182\t      conversations: convs.sort((a,b) => Number(!!b.pinned)-Number(!!a.pinned) || b.updatedAt.localeCompare(a.updatedAt) || a.id.localeCompare(b.id)).map((c) => ({\n   183\t        id: c.id,\n   184\t        title: c.title,\n   185\t        createdAt: c.createdAt,\n   186\t        updatedAt: c.updatedAt,\n   187\t        messageCount: c.messages?.length || 0,\n   188\t        modelProfileId: c.modelProfileId,\n   189\t        pinned: !!c.pinned, archived: !!c.archived,\n   190\t        unread: c.unread, activityRevision: c.activityRevision, readRevision: c.readRevision,\n   191\t        scheduleState: conversationScheduleState(c.id, tasks, runs),\n   192\t        running: convIsExecuting(c.id),\n   193\t        channelCount: new Set([...(c.inboundChannelIds ?? c.channelIds ?? []), ...(c.outboundChannelIds ?? c.channelIds ?? [])]).size,\n   194\t      })),\n   195\t      total: convs.length,\n   196\t    },\n   197\t  };\n   198\t});\n   199\t\n   200\t/**\n   201\t * list_tasks — 列出指定项目的定时任务。\n   202\t */\n   203\tregisterMobileAction('list_tasks', async (payload) => {\n   204\t  const { projectPath } = payload;\n   205\t  if (!projectPath || typeof projectPath !== 'string') {\n   206\t    return { status: 400, error: 'missing projectPath' };\n   207\t  }\n   208\t  if (!(await listProjects()).some(project => project.path === projectPath)) return { status: 404, error: 'Project is not registered' };\n   209\t  const [tasks,runs] = await Promise.all([listScheduledTasks(projectPath),listScheduledRuns(projectPath)]);\n   210\t  const latest = new Map<string, (typeof runs)[number]>();\n   211\t  for (const run of runs) {\n   212\t    if (run.projectPath !== projectPath) continue;\n   213\t    const prior=latest.get(run.taskId);\n   214\t    if (!prior || run.startedAt > prior.startedAt || (run.startedAt === prior.startedAt && run.id.localeCompare(prior.id) < 0)) latest.set(run.taskId,run);\n   215\t  }\n   216\t  return {\n   217\t    status: 200,\n   218\t    data: {\n   219\t      projectPath,\n   220\t      tasks: tasks.map(task => ({ ...task, mobileRun: taskRuns.get(task.id), ...(latest.has(task.id) ? { latestRun: mobileScheduledRunSummary(latest.get(task.id)!, task.name) } : {}) })),\n   221\t      total: tasks.length,\n   222\t      enabledCount: tasks.filter((t) => t.enabled).length,\n   223\t    },\n   224\t  };\n   225\t});\n   226\t\n   227\t// ─── Phase 1 命令集 ─────────────────────────────────────────────────────────\n   228\t\n   229\t/**\n   230\t * create_conversation — 创建新对话。\n   231\t * payload: { projectPath, title?, firstMessage? }\n   232\t */\n   233\tregisterMobileAction('create_conversation', async (payload) => {\n   234\t  const { projectPath, title, firstMessage } = payload;\n   235\t  if (!projectPath || typeof projectPath !== 'string') {\n   236\t    return { status: 400, error: 'missing projectPath' };\n   237\t  }\n   238\t  \n   239\t  if (!(await listProjects()).some(p => p.path === projectPath)) return { status: 400, error: '请先在桌面端打开项目' };\n   240\t  if (title !== undefined && (typeof title !== 'string' || title.length > 200)) return { status: 400, error: '标题过长' };\n   241\t  const conv = newConversation({ projectPath, title });\n   242\t  await initializeConversationPolicy(conv);\n   243\t  \n   244\t  await saveConv(conv);\n   245\t  (await import('./ipc')).notifyMobileConversation(conv, 'created');\n   246\t  let messageError: string | undefined;\n   247\t  if (typeof firstMessage === 'string' && firstMessage.trim()) {\n   248\t    const { submitMobileMessage } = await import('./ipc');\n   249\t    try {\n   250\t      const message = validateMobileMessage({ content: firstMessage });\n   251\t      const result = await submitMobileMessage(conv.id, message.content);\n   252\t      if (!result.ok) messageError = result.error;\n   253\t    } catch (error: any) { messageError = error.message; }\n   254\t  }\n   255\t\n   256\t  return {\n   257\t    status: 200,\n   258\t    data: {\n   259\t      conversationId: conv.id,\n   260\t      title: conv.title,\n   261\t      createdAt: conv.createdAt,\n   262\t      messageCount: conv.messages.length,\n   263\t      messageError,\n   264\t    },\n   265\t  };\n   266\t});\n   267\t\n   268\t/**\n   269\t * list_messages — chronological message windows. Omitted limit keeps legacy full history.\n   270\t * before is exclusive; after is inclusive so a streaming anchor can be refreshed.\n   271\t * payload: { conversationId, limit?, before?, after? }\n   272\t */\n   273\tregisterMobileAction('list_messages', async (payload) => {\n   274\t  const { conversationId, limit, before, after } = payload;\n   275\t  if (!conversationId || typeof conversationId !== 'string') {\n   276\t    return { status: 400, error: 'missing conversationId' };\n   277\t  }\n   278\t  if ((limit !== undefined && (!Number.isInteger(limit) || limit < 1 || limit > 100))\n   279\t    || (before !== undefined && (typeof before !== 'string' || !before || before.length > 200))\n   280\t    || (after !== undefined && (typeof after !== 'string' || !after || after.length > 200))\n   281\t    || (before !== undefined && after !== undefined)\n   282\t    || ((before !== undefined || after !== undefined) && limit === undefined)) {\n   283\t    return { status: 400, error: 'invalid message pagination' };\n   284\t  }\n   285\t  \n   286\t  const { getConvCached, convIsExecuting, getMobileInteractionState } = await import('./ipc');\n   287\t  const conv = await getConvCached(conversationId);\n   288\t\n   289\t  if (!conv) {\n   290\t    return { status: 404, error: 'chat not found' };\n   291\t  }\n   292\t  \n   293\t  const cursor = before ?? after;\n   294\t  const cursorIndex = cursor === undefined ? -1 : conv.messages.findIndex(m => m.id === cursor);\n   295\t  if (cursor !== undefined && cursorIndex < 0) return { status: 409, error: 'message cursor expired' };\n   296\t  const end = before === undefined ? conv.messages.length : cursorIndex;\n   297\t  const start = after !== undefined ? cursorIndex : limit === undefined ? 0 : Math.max(0, end - limit);\n   298\t  const pageEnd = after !== undefined ? Math.min(conv.messages.length, start + limit) : end;\n   299\t  const messages = conv.messages.slice(start, pageEnd);\n   300\t  const interaction = getMobileInteractionState(conv.id);\n   301\t  return {\n   302\t    status: 200,\n   303\t    data: {\n   304\t      conversationId: conv.id,\n   305\t      title: conv.title,\n   306\t      running: interaction.running ?? convIsExecuting(conv.id),\n   307\t      archived: !!conv.archived, pinned: !!conv.pinned, projectPath: conv.projectPath,\n   308\t      queue: interaction.queue, failed: interaction.failed,\n   309\t      waiting: { approvals: interaction.approvalCount, questions: interaction.clarifyCount, plan: interaction.planPending },\n   310\t      activity: {\n   311\t        plan: conv.expertsPlan, canResumePlan: !(interaction.running ?? convIsExecuting(conv.id)) && !conv.archived && canResumeExperts(conv.expertsPlan),\n   312\t        files: conversationFileChanges(conv.messages, conv.projectPath),\n   313\t        turnId: [...conv.messages].reverse().find(m => m.role === 'user' && !m.queued)?.id,\n   314\t      },\n   315\t      page: limit === undefined ? undefined : {\n   316\t        hasMore: start > 0, beforeCursor: messages[0]?.id,\n   317\t        hasMoreNewer: pageEnd < conv.messages.length, afterCursor: messages[messages.length - 1]?.id,\n   318\t      },\n   319\t      messages: messages.map((m) => ({\n   320\t        id: m.id,\n   321\t        role: m.role,\n   322\t        content: m.content,\n   323\t        ts: m.ts,\n   324\t        toolCalls: m.toolCalls?.length || 0,\n   325\t        tools: m.toolCalls?.map(t => ({ id: t.id, name: t.name, isError: t.isError, aborted: t.aborted, approval: t.approval, done: t.result !== undefined })),\n   326\t        images: describeMessageImages(m),\n   327\t        interjection: m.interjection,\n   328\t        pending: !!m.pending,\n   329\t        error: m.error,\n   330\t        canDelete: !conv.archived && !convIsExecuting(conv.id),\n   331\t        canRetry: !conv.archived && !convIsExecuting(conv.id) && !m.pending && !!m.error && m.role === 'assistant' && conv.messages.slice(0, conv.messages.indexOf(m)).some(previous => previous.role === 'user'),\n   332\t      })),\n   333\t      total: conv.messages.length,\n   334\t    },\n   335\t  };\n   336\t});\n   337\t\n   338\tregisterMobileAction('append_message', async ({ conversationId, content }) => {\n   339\t  if (typeof conversationId !== 'string' || typeof content !== 'string' || !content.trim()) {\n   340\t    return { status: 400, error: 'conversationId and content are required' };\n   341\t  }\n   342\t  const { submitMobileMessage } = await import('./ipc');\n   343\t  const result = await submitMobileMessage(conversationId, content.trim());\n   344\t  return result.ok ? { status: 200, data: result } : { status: 409, error: result.error };\n   345\t});\n   346\t\n   347\t/**\n   348\t * create_task — 创建定时任务。\n   349\t * payload: { projectPath, name, prompt, schedule: ScheduleConfig }\n   350\t */\n   351\tregisterMobileAction('create_task', async (payload) => {\n   352\t  const { projectPath, name, prompt, schedule } = payload;\n   353\t  if (!projectPath || typeof projectPath !== 'string') {\n   354\t    return { status: 400, error: 'missing projectPath' };\n   355\t  }\n   356\t  if (!name || typeof name !== 'string') {\n   357\t    return { status: 400, error: 'missing name' };\n   358\t  }\n   359\t  if (!prompt || typeof prompt !== 'string') {\n   360\t    return { status: 400, error: 'missing prompt' };\n   361\t  }\n   362\t  if (!schedule || typeof schedule !== 'object') {\n   363\t    return { status: 400, error: 'missing schedule' };\n   364\t  }\n   365\t  \n   366\t  const task = await createScheduledTask(projectPath, name, prompt, schedule, payload.options ?? {});\n   367\t  \n   368\t  return {\n   369\t    status: 200,\n   370\t    data: {\n   371\t      taskId: task.id,\n   372\t      name: task.name,\n   373\t      createdAt: task.createdAt,\n   374\t    },\n   375\t  };\n   376\t});\n   377\t\n   378\t/**\n   379\t * update_task — 更新任务。\n   380\t * payload: { taskId, patch: { name?, prompt?, schedule?, enabled?, channelIds? } }\n   381\t */\n   382\tregisterMobileAction('update_task', async (payload) => {\n   383\t  const { taskId, patch } = payload;\n   384\t  if (!taskId || typeof taskId !== 'string') {\n   385\t    return { status: 400, error: 'missing taskId' };\n   386\t  }\n   387\t  if (!patch || typeof patch !== 'object') {\n   388\t    return { status: 400, error: 'missing patch' };\n   389\t  }\n   390\t  \n   391\t  const task = await updateScheduledTask(taskId, patch, payload.expectedUpdatedAt);\n   392\t  if (!task) {\n   393\t    return { status: 404, error: 'task not found' };\n   394\t  }\n   395\t  \n   396\t  return {\n   397\t    status: 200,\n   398\t    data: {\n   399\t      taskId: task.id,\n   400\t      name: task.name,\n   401\t      enabled: task.enabled,\n   402\t      updatedAt: task.updatedAt,\n   403\t    },\n   404\t  };\n   405\t});\n   406\t\n   407\t/**\n   408\t * delete_task — 删除任务。\n   409\t * payload: { taskId }\n   410\t */\n   411\tregisterMobileAction('delete_task', async (payload) => {\n   412\t  const { taskId } = payload;\n   413\t  if (!taskId || typeof taskId !== 'string') {\n   414\t    return { status: 400, error: 'missing taskId' };\n   415\t  }\n   416\t  \n   417\t  const deleted = await deleteScheduledTask(taskId);\n   418\t  if (!deleted) return { status: 404, error: 'task not found' };\n   419\t  \n   420\t  return {\n   421\t    status: 200,\n   422\t    data: {\n   423\t      taskId,\n   424\t      deleted,\n   425\t    },\n   426\t  };\n   427\t});\n   428\t\n   429\t/**\n   430\t * run_task_now — 立即执行任务。\n   431\t * payload: { taskId }\n   432\t */\n   433\tregisterMobileAction('run_task_now', async (payload) => {\n   434\t  const { taskId } = payload;\n   435\t  if (!taskId || typeof taskId !== 'string') {\n   436\t    return { status: 400, error: 'missing taskId' };\n   437\t  }\n   438\t  \n   439\t  if (taskRuns.get(taskId)?.running) return { status: 409, error: 'Task is already running' };\n   440\t  const projects = await listProjects();\n   441\t  let found = false;\n   442\t  for (const project of projects) {\n   443\t    if ((await listScheduledTasks(project.path)).some(task => task.id === taskId)) { found = true; break; }\n   444\t  }\n   445\t  if (!found) return { status: 404, error: 'task not found' };\n   446\t  // Recheck after asynchronous lookups, before reserving the task.\n   447\t  if (taskRuns.get(taskId)?.running) return { status: 409, error: 'Task is already running' };\n   448\t  taskRuns.set(taskId, { running: true });\n   449\t  void runScheduledTaskNow(taskId).then(result => {\n   450\t    taskRuns.set(taskId, { running: false, error: result.ok ? undefined : result.error || 'Task failed' });\n   451\t  }, error => { taskRuns.set(taskId, { running: false, error: String(error?.message || error) }); }).finally(() => {\n   452\t    for (const [id, run] of taskRuns) { if (taskRuns.size <= 128) break; if (!run.running) taskRuns.delete(id); }\n   453\t  });\n   454\t  return { status: 200, data: { taskId, started: true } };\n   455\t\n   456\t});\n   457\t\n   458\t// ─── 状态提供者 ─────────────────────────────────────────────────────────────\n   459\t\n   460\t/**\n   461\t * 状态字段动态提供者。\n   462\t */\n   463\ttype StatusProvider = () => Record<string, unknown>;\n   464\tconst statusProviders: StatusProvider[] = [];\n   465\t\n   466\texport function registerStatusProvider(provider: StatusProvider): void {\n   467\t  statusProviders.push(provider);\n   468\t}\n   469\t\n   470\t\n   471\tregisterMobileChatActions(registerMobileAction);\n   472\tregisterMobileApprovalActions(registerMobileAction);\n   473\tregisterMobileManagementActions(registerMobileAction);\n   474\tregisterMobileProjectActions(registerMobileAction);\n   475\tregisterMobileMermaidActions(registerMobileAction);\n   476\tregisterMobileMessageImageActions(registerMobileAction);\n   477\t\n   478\tregisterMobileMessageActions(registerMobileAction);\n   479\tregisterMobileProjectIconActions(registerMobileAction);\n   480\t"
